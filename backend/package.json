{
    "name": "encrypted-notes-backend",
    "version": "2.1.1",
    "description": "Encrypted Notes Backend API - Cloudflare Worker",
    "main": "src/index.js",
    "scripts": {
      "dev": "wrangler dev",
      "deploy:preview": "wrangler deploy --env preview",
      "deploy:staging": "wrangler deploy --env staging",
      "deploy:production": "wrangler deploy --env production",
      "init-db:local": "wrangler d1 execute staging-notes-db --local --file=src/db/schema.sql",
      "init-db:preview": "wrangler d1 execute staging-notes-db --env preview --file=src/db/schema.sql",
      "init-db:staging": "wrangler d1 execute staging-notes-db --env staging --file=src/db/schema.sql",
      "init-db:production": "wrangler d1 execute notes-db --env production --file=src/db/schema.sql",
      "backup:local": "wrangler d1 export staging-notes-db --local --output=backup-local-$(date +%Y%m%d).sql",
      "backup:preview": "wrangler d1 export staging-notes-db --env preview --output=backup-preview-$(date +%Y%m%d).sql",
      "backup:staging": "wrangler d1 export staging-notes-db --env staging --output=backup-staging-$(date +%Y%m%d).sql",
      "backup:production": "wrangler d1 export notes-db --env production --output=backup-production-$(date +%Y%m%d).sql"
    },
    "keywords": ["cloudflare", "worker", "notes", "encryption", "backup"],
    "author": "",
    "license": "MIT",
    "devDependencies": {
      "wrangler": "^4.92.0"
    }
  }