{
    "name": "我的加密笔记",
    "short_name": "加密笔记",
    "description": "安全、私密、高效的个人笔记管理系统 - 端对端加密，数据仅您可见",
    "start_url": "/",
    "display": "standalone",
    "orientation": "portrait",
    "background_color": "#0f172a",
    "theme_color": "#0f172a",
    "categories": ["productivity", "utilities"],
    "lang": "zh-CN",
    "dir": "ltr",
    
    "icons": [
